# Copy to .env (or export) - all values are optional, defaults shown.
DATABASE_URL=sqlite:///./data/certificates.db
STORAGE_DIR=./data/certificates
MAX_RECIPIENTS_PER_JOB=1000
# Require this key in the X-API-Key header on all API calls (empty = auth disabled)
API_KEY=
# Public address of the service; used for the QR code link on each certificate
PUBLIC_BASE_URL=http://localhost:8000
